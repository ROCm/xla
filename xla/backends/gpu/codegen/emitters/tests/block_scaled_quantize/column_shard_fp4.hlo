// RUN: gpu_fusion_to_mlir %s | FileCheck %s
// RUN: gpu_fusion_to_mlir %s | emitters_opt -xla-test-optimize \
// RUN:   -xla-gpu-test-transform-loops | FileCheck %s --check-prefix=CHECK-VEC

// The column blocks of an FSDP weight shard, whose FP4 data keep the source's
// order: the column phase passes its scales through shared memory, and the
// data are written along the rows, so no lane stores a lone nibble.

// CHECK-LABEL: func.func @main(
// CHECK:         xla_gpu.allocate_shared : tensor<128x65xf32>
// CHECK:         xla_gpu.sync_threads
// CHECK:         xla_gpu.allocate_shared : tensor<4x64xf32>
// CHECK:         xla_gpu.sync_threads

// CHECK-VEC-LABEL: func.func @main(
// CHECK-VEC-NOT:     tensor.insert {{.*}}xf4E2M1FN>
// CHECK-VEC:         vector.transfer_write {{.*}} : vector<4xf4E2M1FN>, tensor<131072xf4E2M1FN>
// CHECK-VEC-NOT:     tensor.insert {{.*}}xf4E2M1FN>
// CHECK-VEC:         return

max_f32 {
  a = f32[] parameter(0)
  b = f32[] parameter(1)
  ROOT m = f32[] maximum(a, b)
}

fused_quantize {
  stack = f32[2,512,256] parameter(0)
  index = s32[] parameter(1)
  zero_index = s32[] constant(0)
  ds = f32[1,512,256] dynamic-slice(stack, index, zero_index, zero_index), dynamic_slice_sizes={1,512,256}
  ds_bf16 = bf16[1,512,256] convert(ds)
  abs = f32[1,512,256] abs(ds)
  abs_bf16 = bf16[1,512,256] convert(abs)
  ninf = bf16[] constant(-inf)
  ninf_f32 = f32[] convert(ninf)
  lo = f32[] constant(-6)
  hi = f32[] constant(6)
  inv = f32[] constant(0.166666672)
  k_mant = u32[] constant(8388607)
  k0 = u32[] constant(0)
  k23 = u32[] constant(23)
  k254 = u32[] constant(254)
  k_half = u32[] constant(4194304)
  k1 = u32[] constant(1)
  f0 = f32[] constant(0)
  tiny = f32[] constant(5.87747175e-39)
  c_xs = bf16[16,32,256] bitcast(ds_bf16)
  c_x = f32[16,32,256] convert(c_xs)
  c_ab0 = bf16[1,256,16,32]{1,3,2,0} bitcast(abs_bf16)
  c_ab1 = bf16[256,16,32]{0,2,1} bitcast(c_ab0)
  c_ab = bf16[16,32,256] bitcast(c_ab1)
  c_abf = f32[16,32,256] convert(c_ab)
  c_amax = f32[16,256] reduce(c_abf, ninf_f32), dimensions={1}, to_apply=max_f32
  c_amax_bf16 = bf16[16,256] convert(c_amax)
  c_amax_f32 = f32[16,256] convert(c_amax_bf16)
  c_inv_b = f32[16,256] broadcast(inv), dimensions={}
  c_ratio = f32[16,256] multiply(c_amax_f32, c_inv_b)
  c_bits = u32[16,256] bitcast(c_ratio)
  c_mant_mask = u32[16,256] broadcast(k_mant), dimensions={}
  c_mant = u32[16,256] and(c_bits, c_mant_mask)
  c_zero = u32[16,256] broadcast(k0), dimensions={}
  c_gt = pred[16,256] compare(c_mant, c_zero), direction=GT
  c_s23 = u32[16,256] broadcast(k23), dimensions={}
  c_exp = u32[16,256] shift-right-logical(c_bits, c_s23)
  c_e254 = u32[16,256] broadcast(k254), dimensions={}
  c_ne = pred[16,256] compare(c_exp, c_e254), direction=NE
  c_and0 = pred[16,256] and(c_gt, c_ne)
  c_eq0 = pred[16,256] compare(c_exp, c_zero), direction=EQ
  c_half = u32[16,256] broadcast(k_half), dimensions={}
  c_le = pred[16,256] compare(c_mant, c_half), direction=LE
  c_and1 = pred[16,256] and(c_eq0, c_le)
  c_not = pred[16,256] not(c_and1)
  c_round_up = pred[16,256] and(c_and0, c_not)
  c_one = u32[16,256] broadcast(k1), dimensions={}
  c_exp1 = u32[16,256] add(c_exp, c_one)
  c_exp_sel = u32[16,256] select(c_round_up, c_exp1, c_exp)
  c_scale = u8[16,256] convert(c_exp_sel)
  c_scale32 = u32[16,256] convert(c_scale)
  c_shl = u32[16,256] shift-left(c_scale32, c_s23)
  c_pow = f32[16,256] bitcast(c_shl)
  c_fzero = f32[16,256] broadcast(f0), dimensions={}
  c_is_zero = pred[16,256] compare(c_pow, c_fzero), direction=EQ
  c_tiny_b = f32[16,256] broadcast(tiny), dimensions={}
  c_decoded = f32[16,256] select(c_is_zero, c_tiny_b, c_pow)
  c_bs = f32[16,32,256] broadcast(c_decoded), dimensions={0,2}
  c_q = f32[16,32,256] divide(c_x, c_bs)
  c_lo_b = f32[16,32,256] broadcast(lo), dimensions={}
  c_hi_b = f32[16,32,256] broadcast(hi), dimensions={}
  c_cl = f32[16,32,256] clamp(c_lo_b, c_q, c_hi_b)
  c_data = f4e2m1fn[16,32,256]{2,1,0:E(4)} convert(c_cl)
  ROOT t = (f4e2m1fn[16,32,256]{2,1,0:E(4)}, u8[16,256]) tuple(c_data, c_scale)
}

ENTRY main {
  stack = f32[2,512,256] parameter(0)
  index = s32[] parameter(1)
  ROOT fusion = (f4e2m1fn[16,32,256]{2,1,0:E(4)}, u8[16,256]) fusion(stack, index), kind=kCustom,
      calls=fused_quantize,
      backend_config={"fusion_backend_config":{"kind":"__block_scaled_quantize"}}
}
